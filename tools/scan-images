#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# papAIa — scan-images · vulnerability gate of the core's own images
# by Fidonis GmbH · https://fidonis.de
#
# Scans every platform of the digests in a builds file of build-images with a
# pinned Trivy image and gates the findings against security/exceptions.yaml
# (lib/image_scan.py; docs/compatibility.md, "Own images of the core").
#
# Usage:
#   scan-images check [--exceptions=FILE]
#   scan-images gate  --report=FILE --artifact=REF [--exceptions=FILE]
#   scan-images scan  --builds=FILE --out=DIR [--cache=DIR] [--exceptions=FILE]
#
# Exit codes: 0 passed, 1 a finding or an expired exception fails, 2 invalid input.
# Needs Docker (scan) and Python 3.10+ with PyYAML.
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=lib/sh/python.sh
source "$REPO_ROOT/tools/lib/sh/python.sh"
find_python || exit 2

PYTHONPATH="$REPO_ROOT/tools${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$PYTHON_BIN" -m lib.image_scan --repo-root "$REPO_ROOT" "$@"

#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# papAIa — papaia-ctl · core orchestrator
# by Fidonis GmbH · https://fidonis.de
#
# Bootstraps a fresh papAIa checkout into a runnable core stack with one
# idempotent command. Bash owns arg-parsing, interactive prompts, and
# `docker compose` invocations; all YAML/JSON/.env manipulation is
# delegated to tools/lib/*.py (invoked via `python3 -m lib.cli`).
#
# Usage:
#   papaia-ctl setup    [--config-dir=PATH] [--env=NAME] [--host-ip=IP]
#                       [--app-host=URL] [--auth-host=URL] [--librechat-host=URL]
#                       [--litellm-host=URL] [--npm-admin-host=URL]
#                       [--auth-provider=internal_keycloak|external_oidc]
#                       [--oidc-issuer=URL]
#                       [--reverse-proxy-provider=internal_nginx|external_proxy|no_proxy]
#                       [--external-reverse-proxy|--no-external-reverse-proxy]
#                       [--web-search|--no-web-search] [--reranker-model=NAME]
#                       [--local-ai|--no-local-ai] [--localai-host=URL]
#                       [--localai-variant=cpu|nvidia-cuda-12|nvidia-cuda-13|intel|hipblas|vulkan|auto]
#                       [--localai-runtime=container|native]
#                       [--manager|--no-manager] [--manager-host=URL]
#                       [--rag|--no-rag] [--qdrant-host=URL]
#                       [--voice|--no-voice] [--voice-variant=cpu|nvidia|hipblas|auto]
#                       [--knowledge-map|--no-knowledge-map] [--ca-bundle=FILE]
#                       [--smtp|--no-smtp] [--smtp-host=HOST] [--smtp-port=PORT]
#                       [--smtp-security=starttls|tls|none] [--smtp-user=NAME|--smtp-no-auth]
#                       [--smtp-from=ADDRESS] [--smtp-from-name=NAME]
#                       [--backup-dir=PATH] [--env-only]
#                       [--allow-direct-port-access] [--force] [-y]
#                       [--approve-pairings=SHA256]  (-y never confirms pairings)
#                       [--topology=single|distributed] [--node=NAME=ADDR[,ssh=USER@HOST[:PORT]]]
#                       [--controller=NAME] [--preset=dmz-split|dmz-edge] [--place=SERVICE=NODE]
#                       [--link-port=PORT] [--topology-file=PATH]
#   papaia-ctl start         [--addons] [--profiles=LIST] [--node=NAME] [--unlock] [--force]
#                            [--insecure-images] [--config-dir=PATH]
#   papaia-ctl stop          [--clean-up [--volumes]] [--addons] [--profiles=LIST] [--node=NAME]
#                            [--config-dir=PATH]
#   papaia-ctl upgrade       [--version=X.Y.Z] [--dry-run] [--force] [-y] [--insecure-images]
#                            [--identity=FILE|-] [--no-rollback-key] [--stage=NAME[,NAME]]
#                            [--addon-path=NAME=DIR] [--config-dir=PATH] — stages: core, me,
#                            data, studio, flow, assist, finish; rollback key, restore point
#                            R0 and write lock first (--identity needed with --no-rollback-key)
#   papaia-ctl upgrade --resume [--identity=FILE|-] [--stage=NAME[,NAME]] [-y]
#   papaia-ctl upgrade --release-lock [-y] — after going back to R0
#   papaia-ctl upgrade --finalize [-y] — delete the rollback key before its window ends
#   papaia-ctl rollback      [--restore-point=R0] [--identity=FILE|-] [--accept-data-loss] [-y]
#                            [--config-dir=PATH] — back to R0 of the last upgrade
#   papaia-ctl uninstall     [--clean-up] [--addons] [-y] [--config-dir=PATH]
#   papaia-ctl backup        [--backup-dir=PATH] [--keep=N] [--retention-period-days=N]
#                            [--only=SELECTOR[,SELECTOR]] [--config-dir=PATH]
#   papaia-ctl backup recipients list|add|remove [--name=NAME] [--key=age1...]
#   papaia-ctl backup keys generate [--names=A,B]
#   papaia-ctl backup target init|check [--backup-dir=PATH]
#   papaia-ctl backup key-check --identity=FILE|- [--restore-point=ID]
#   papaia-ctl backup-delete --restore-point=ID [--restore-point=ID ...]
#                            [--backup-dir=PATH] [-y] [--config-dir=PATH]
#                            --restore-point is repeatable or comma-separated
#   papaia-ctl restore       [--backup-dir=PATH] [--restore-point=ID] [--list]
#                            [--identity=FILE|-] [--only=SELECTOR[,SELECTOR]] [--restart-clean]
#                            [--no-restart] [--insecure-images] [-y] [--config-dir=PATH]
#                            SELECTOR is module:NAME, addon:NAME or volume:NAME
#                            (and node:NAME in a distributed installation)
#   papaia-ctl restore-scoped --only=SELECTOR[,SELECTOR] [as restore, minus
#                            --restart-clean] — restore that cannot replace the
#                            configuration directory, for in-stack callers
#   papaia-ctl post-restore  [--since=EPOCH] [--config-dir=PATH] — revoke the sessions
#                            and delegations a restore brought back (restore runs it)
#   papaia-ctl halt set      [--reason=TEXT] [--config-dir=PATH] — stop every write, send
#                            and delete of the platform, without Keycloak (also: halt on)
#   papaia-ctl halt clear    --reason=TEXT [--config-dir=PATH] — lift it (also: halt off)
#   papaia-ctl halt status   [--json] [--config-dir=PATH]
#   papaia-ctl delegations lifetime [--idle-days=N] [--max-days=N] [--json] [--config-dir=PATH]
#                            — how long delegations live: without values show them; with
#                            values set them (1-365 days, idle <= max; kritis at most 7 / 30)
#   papaia-ctl npm-provision [--config-dir=PATH]
#   papaia-ctl proxy list    [--json] [--config-dir=PATH] — host name -> internal target of
#                            every web interface, the forwards of an external proxy
#   papaia-ctl keycloak-role-sync [--config-dir=PATH]
#   papaia-ctl realm sync    [--check] [--config-dir=PATH]
#   papaia-ctl realm keys apply <module> [--config-dir=PATH] — register the public keys
#                            a module wrote for the clients in its client_keys
#   papaia-ctl catalog render [--config-dir=PATH] — write platform/services.json from
#                            the exposes declarations (setup, start and addon do it too)
#   papaia-ctl settings show [--json] [--config-dir=PATH] — contact point, brand, four eyes
#   papaia-ctl settings set  <key> <value> [--config-dir=PATH] — keys: branding.name,
#                            branding.suffix, branding.logo (a PNG, JPEG or WebP file),
#                            contact.name, contact.mail, contact.phone, approvals.four_eyes
#                            (on|off; always on in security profile kritis)
#   papaia-ctl settings unset <key> [--config-dir=PATH] — branding.name, branding.suffix,
#                            branding.logo, contact, contact.mail, contact.phone
#   papaia-ctl privacy-pack  [--lang=de] [--out=DIR] [--check] — the data protection package
#                            docs/de/datenschutz/ from the storage declarations
#   papaia-ctl privacy-pack  --installation --out=FILE --backup-retention=DAYS
#                            [--format=html|pdf|md] [--offsite=PLACE --offsite-retention=DAYS]
#                            [--config-dir=PATH]
#   papaia-ctl report permissions --by=person|system [--format=json|csv]
#                            --token-file=PATH|- [--config-dir=PATH] — the permission
#                            report, released by papaia-audit (role papaia-auditor)
#   papaia-ctl report confirm --key=KEY --digest=SHA256 --token-file=PATH|-
#                            [--config-dir=PATH] — recertify one row (role papaia-admin)
#   papaia-ctl breakglass create|rotate|status [--address=EMAIL] [--config-dir=PATH]
#                            — the emergency account; its password is shown once
#   papaia-ctl service-account list   [--json] [--config-dir=PATH]
#   papaia-ctl service-account rotate <id> [--grace=SECONDS] [--config-dir=PATH]
#   papaia-ctl secrets rotate paperless-gate/proxy [--config-dir=PATH]
#   papaia-ctl certs renew   [--force] [--ca] [--config-dir=PATH]
#   papaia-ctl certs status  [--json] [--config-dir=PATH]
#   papaia-ctl status        [--json] [--profiles=LIST] [--addons] [--config-dir=PATH]
#   papaia-ctl doctor        [CHECK...] [--json] [--skip=CHECK[,CHECK]] [--config-dir=PATH]
#   papaia-ctl topology show [--json] [--config-dir=PATH]
#   papaia-ctl topology validate [--config-dir=PATH]
#   papaia-ctl topology firewall [--format=table|json|csv] [--config-dir=PATH]
#   papaia-ctl node add      <name> --address=ADDR [--ssh=USER@HOST[:PORT]] [--root=DIR]
#                            [--gpu=none|nvidia|amd|intel|vulkan] [--bind-ip=IP]
#                            [--ingress-ip=IP]
#                            [--bootstrap=join|admin] [--admin=USER@HOST[:PORT]]
#                            [--output=FILE] [--host-key-fingerprint=SHA256:...] [-y]
#   papaia-ctl node list     [--json] [--check] [--config-dir=PATH]
#   papaia-ctl node check    <name> [--host-key-fingerprint=SHA256:...] [--json] [-y]
#   papaia-ctl node remove   <name> [-y] [--config-dir=PATH]
#   papaia-ctl node join-bundle <name> [--output=FILE] [--config-dir=PATH]
#   papaia-ctl node renew-link <name> [--config-dir=PATH]
#   papaia-ctl node sync     <name>|--all [--checkout] [--config-dir=PATH]
#   papaia-ctl node-shell    the forced command of a node's SSH key; never run by hand
#   papaia-ctl addon install   <name> --path=PATH [--version=VER] [--node=NAME] [--force]
#                              [--insecure-images] [--accept-unlisted-images]
#                              [--config-dir=PATH]
#   papaia-ctl addon start     <name> [--force] [--insecure-images] [--config-dir=PATH]
#   papaia-ctl addon check     [--target-core=PATH] [--target-version=X.Y.Z]
#                              [--target-addon-api=N [--target-min-addon-api=M]]
#                              [--json] [--force] [--config-dir=PATH]
#   papaia-ctl addon components [<name>] [--json] [--config-dir=PATH]
#   papaia-ctl addon upgrade   <name> --path=DIR [--dry-run [--json]] [--no-backup] [--no-restart]
#                              [--answers-file=FILE] [--force] [--insecure-images] [-y]
#                              [--config-dir=PATH]
#   papaia-ctl addon rollback  <name> [--restore-data] [--no-restart] [--force]
#                              [--insecure-images] [-y] [--config-dir=PATH]
#   papaia-ctl addon list      [--json] [--config-dir=PATH]
#   papaia-ctl addon stop      <name> [--clean-up] [--config-dir=PATH]
#   papaia-ctl addon remove    <name> [--force] [--config-dir=PATH]
#   papaia-ctl addon uninstall <name> [--purge-data] [--force] [--config-dir=PATH]
#   papaia-ctl addon run       <name> [<action>] [--json] [--config-dir=PATH]
#   papaia-ctl suite verify  --bom=FILE [--signature=FILE] [--json]
#                            [--key=FILE | --fingerprint=sha256:HEX]
#                            [--suite=VERSION] [--scope=delivery|test]
#   papaia-ctl pairing list  [--json] [--config-dir=PATH] — exchange-right pairings of the
#                            signed bill of materials, their state and the sha256 of the list
#   papaia-ctl pairing confirm --approve-pairings=SHA256 [--config-dir=PATH]
#   papaia-ctl pairing approve --client=NAME --audience=NAME [--effects=rwdx]
#                            [--config-dir=PATH] — a write pairing needs a second person
#   papaia-ctl pairing revoke --client=NAME --audience=NAME [--config-dir=PATH]
#   papaia-ctl librechat clear-history <email> [--before=YYYY-MM-DD] [--dry-run] [-y]
#                              [--config-dir=PATH]
#   papaia-ctl audit cert    <source> [--config-dir=PATH]
#   papaia-ctl audit verify  [--source=NAME] [--against=FILE] [--json] [--config-dir=PATH]
#   papaia-ctl audit heads   [--config-dir=PATH]
#   papaia-ctl audit token-keys [--config-dir=PATH]
#   papaia-ctl audit retention [--config-dir=PATH]
#   papaia-ctl audit siem status [--config-dir=PATH]
#   papaia-ctl audit siem skip --source=NAME --until=SEQ --reason=TEXT [--target=TARGET]
#   papaia-ctl audit idmap --ticket=ID (--pseud=P-XXXXXXXX | --tid=ID --oid=ID)
#       (token of the auditor in PAPAIA_AUDIT_TOKEN) [--config-dir=PATH]
#   papaia-ctl help
#
# Internal, set by papaia-ctl when 'upgrade' re-executes itself from the
# release it just checked out:
#   --resume-from=X.Y.Z --resume-target=X.Y.Z [--resume-restore-point=ID]
#   [--resume-stages=LIST] [--resume-started=EPOCH]
# and by 'rollback' from the release it went back to: --resume-upgrade-id=ID
#   --resume-restore-point=ID (only for the run's R0, with its data-loss confirmation)
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$REPO_ROOT/src/docker-compose.yml"

usage() {
    # Prints the header block above verbatim -- keep this range in step with it
    # whenever a command or flag line is added.
    sed -n '2,172p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# --- command libraries --------------------------------------------------------
# All command implementations live in tools/lib/sh/ next to this script;
# whatever installs papaia-ctl must ship that directory alongside the
# entrypoint. Sourcing order matters only for log.sh (preflight below logs).
# shellcheck source-path=SCRIPTDIR
SH_LIB="$REPO_ROOT/tools/lib/sh"
# shellcheck source=lib/sh/log.sh
source "$SH_LIB/log.sh"
# shellcheck source=lib/sh/python.sh
source "$SH_LIB/python.sh"
# shellcheck source=lib/sh/prompt.sh
source "$SH_LIB/prompt.sh"
# shellcheck source=lib/sh/certs.sh
source "$SH_LIB/certs.sh"
# shellcheck source=lib/sh/setup.sh
source "$SH_LIB/setup.sh"
# shellcheck source=lib/sh/lifecycle.sh
source "$SH_LIB/lifecycle.sh"
# shellcheck source=lib/sh/addon.sh
source "$SH_LIB/addon.sh"
# shellcheck source=lib/sh/backup.sh
source "$SH_LIB/backup.sh"
# shellcheck source=lib/sh/upgrade.sh
source "$SH_LIB/upgrade.sh"
# shellcheck source=lib/sh/diag.sh
source "$SH_LIB/diag.sh"
# shellcheck source=lib/sh/topology.sh
source "$SH_LIB/topology.sh"
# shellcheck source=lib/sh/node.sh
source "$SH_LIB/node.sh"
# shellcheck source=lib/sh/librechat.sh
source "$SH_LIB/librechat.sh"
# shellcheck source=lib/sh/secrets.sh
source "$SH_LIB/secrets.sh"
# shellcheck source=lib/sh/halt.sh
source "$SH_LIB/halt.sh"
# shellcheck source=lib/sh/settings.sh
source "$SH_LIB/settings.sh"
# shellcheck source=lib/sh/audit.sh
source "$SH_LIB/audit.sh"
# shellcheck source=lib/sh/pairing.sh
source "$SH_LIB/pairing.sh"
# shellcheck source=lib/sh/delegations.sh
source "$SH_LIB/delegations.sh"
# shellcheck source=lib/sh/report.sh
source "$SH_LIB/report.sh"

# --- preflight ---------------------------------------------------------------
if [ ! -f "$COMPOSE_FILE" ]; then
    error "Marker file not found: $COMPOSE_FILE"
    error "papaia-ctl must be run from within a papAIa checkout."
    exit 2
fi

find_python || exit 2

# Every `lib.cli` subcommand pulls in PyYAML transitively (lib/backup.py imports
# it at module load), so without it each command aborts with a bare
# "No module named 'yaml'" that names the import, not the package to install.
# Check once here and point at the fix instead.
if ! "$PYTHON_BIN" -c 'import yaml' >/dev/null 2>&1; then
    error "Python module 'yaml' (PyYAML) not found for '$PYTHON_BIN'. Install it and re-run:"
    error "  Debian/Ubuntu: sudo apt-get install -y python3-yaml"
    error "  Fedora/RHEL:   sudo dnf install -y python3-pyyaml"
    error "  macOS:         $PYTHON_BIN -m venv ~/.venvs/papaia"
    error "                 ~/.venvs/papaia/bin/pip install 'PyYAML>=6.0'"
    error "                 source ~/.venvs/papaia/bin/activate"
    error "  other:         $PYTHON_BIN -m pip install 'PyYAML>=6.0', in a virtual environment"
    error "                 if pip refuses with 'externally-managed-environment'"
    exit 2
fi

# shellcheck disable=SC2034  # consumed by the sourced command libraries
DEFAULT_CONFIG_DIR="$(dirname "$REPO_ROOT")/papaia-config"

py_cli() {
    PYTHONPATH="$REPO_ROOT/tools${PYTHONPATH:+:$PYTHONPATH}" \
        "$PYTHON_BIN" -m lib.cli --repo-root "$REPO_ROOT" --config-dir "$CONFIG_DIR" "$@"
}

# ─────────────────────────────────────────────────────────────────────────
# dispatch
# ─────────────────────────────────────────────────────────────────────────
if [ $# -eq 0 ]; then
    usage
    exit 0
fi

cmd="$1"; shift || true
case "$cmd" in
    setup)     cmd_setup "$@" ;;
    start)         cmd_start "$@" ;;
    stop)          cmd_stop "$@" ;;
    upgrade)       cmd_upgrade "$@" ;;
    rollback)      cmd_rollback "$@" ;;
    # One name for the operation, not two: 'update' means "refresh the package
    # index" in the most widespread precedent (apt), which is the opposite of
    # what this does.
    update)        error "No 'update' command. Did you mean 'papaia-ctl upgrade'?"; exit 2 ;;
    uninstall)     cmd_uninstall "$@" ;;
    backup)        cmd_backup "$@" ;;
    backup-delete) cmd_backup_delete "$@" ;;
    restore)       cmd_restore "$@" ;;
    restore-scoped) cmd_restore_scoped "$@" ;;
    post-restore)  cmd_post_restore "$@" ;;
    halt)          cmd_halt "$@" ;;
    delegations)   cmd_delegations "$@" ;;
    report)        cmd_report "$@" ;;
    breakglass)    cmd_breakglass "$@" ;;
    npm-provision) cmd_npm_provision "$@" ;;
    proxy)         cmd_proxy "$@" ;;
    keycloak-role-sync) cmd_keycloak_role_sync "$@" ;;
    status)        cmd_status "$@" ;;
    doctor)        cmd_doctor "$@" ;;
    topology)      cmd_topology "$@" ;;
    node)          cmd_node "$@" ;;
    node-shell)    cmd_node_shell "$@" ;;
    librechat)     cmd_librechat "$@" ;;
    audit)         cmd_audit "$@" ;;
    pairing)       cmd_pairing "$@" ;;
    addon)
        sub="${1:-}"; shift || true
        case "$sub" in
            install)   cmd_addon_install "$@" ;;
            start)     cmd_addon_start "$@" ;;
            upgrade)   cmd_addon_upgrade "$@" ;;
            update)    error "No 'addon update' command. Did you mean 'papaia-ctl addon upgrade'?"; exit 2 ;;
            rollback)  cmd_addon_rollback "$@" ;;
            list)      cmd_addon_list "$@" ;;
            check)     cmd_addon_check "$@" ;;
            components) cmd_addon_components "$@" ;;
            stop)      cmd_addon_stop "$@" ;;
            remove)    cmd_addon_remove "$@" ;;
            uninstall) cmd_addon_uninstall "$@" ;;
            run)       cmd_addon_run "$@" ;;
            *) error "Unknown 'addon' subcommand: '${sub:-<none>}'. Valid: install, start, upgrade, rollback, list, check, components, stop, remove, uninstall, run."; exit 2 ;;
        esac
        ;;
    realm)
        sub="${1:-}"; shift || true
        case "$sub" in
            sync)      cmd_realm_sync "$@" ;;
            keys)      cmd_realm_keys "$@" ;;
            *) error "Unknown 'realm' subcommand: '${sub:-<none>}'. Valid: sync, keys."; exit 2 ;;
        esac
        ;;
    catalog)
        sub="${1:-}"; shift || true
        case "$sub" in
            render)    cmd_catalog_render "$@" ;;
            *) error "Unknown 'catalog' subcommand: '${sub:-<none>}'. Valid: render."; exit 2 ;;
        esac
        ;;
    settings)      cmd_settings "$@" ;;
    privacy-pack)  cmd_privacy_pack "$@" ;;
    service-account) cmd_service_account "$@" ;;
    certs)         cmd_certs "$@" ;;
    secrets)
        sub="${1:-}"; shift || true
        case "$sub" in
            rotate)    cmd_secrets_rotate "$@" ;;
            *) error "Unknown 'secrets' subcommand: '${sub:-<none>}'. Valid: rotate."; exit 2 ;;
        esac
        ;;
    suite)
        sub="${1:-}"; shift || true
        case "$sub" in
            verify)    cmd_suite_verify "$@" ;;
            *) error "Unknown 'suite' subcommand: '${sub:-<none>}'. Valid: verify."; exit 2 ;;
        esac
        ;;
    help|-h|--help) usage ;;
    *) error "Unknown command: $cmd"; usage; exit 2 ;;
esac

# --- preflight ---------------------------------------------------------------
if [ ! -f "$COMPOSE_FILE" ]; then
    error "Marker file not found: $COMPOSE_FILE"
    error "papaia-ctl must be run from within a papAIa checkout."
    exit 2
fi

# lib.cli runs from the runtime environment only (lib/sh/runtime.sh): setup, upgrade and
# rollback build or reuse it, every other command checks it and stops with one line.
ctl_runtime_preflight "${1:-}"

# shellcheck disable=SC2034  # consumed by the sourced command libraries
DEFAULT_CONFIG_DIR="$(dirname "$REPO_ROOT")/papaia-config"

py_cli() {
    if [ "${PAPAIA_CTL_DEBUG:-}" = "1" ]; then
        printf '[debug] lib.cli %s runs on %s\n' "${1:-}" "$PYTHON_BIN" >&2
    fi
    PYTHONPATH="$REPO_ROOT/tools${PYTHONPATH:+:$PYTHONPATH}" \
        "$PYTHON_BIN" -P -m lib.cli --repo-root "$REPO_ROOT" --config-dir "$CONFIG_DIR" "$@"
}

# ─────────────────────────────────────────────────────────────────────────
# dispatch
# ─────────────────────────────────────────────────────────────────────────
if [ $# -eq 0 ]; then
    usage
    exit 0
fi

# The command table. Its body keeps the indentation of the top level it used to sit in.
_dispatch() {
cmd="$1"; shift || true
case "$cmd" in
    setup)     cmd_setup "$@" ;;
    start)         cmd_start "$@" ;;
    stop)          cmd_stop "$@" ;;
    upgrade)       cmd_upgrade "$@" ;;
    rollback)      cmd_rollback "$@" ;;
    # One name for the operation, not two: 'update' means "refresh the package
    # index" in the most widespread precedent (apt), which is the opposite of
    # what this does.
    update)        error "No 'update' command. Did you mean 'papaia-ctl upgrade'?"; exit 2 ;;
    uninstall)     cmd_uninstall "$@" ;;
    backup)        cmd_backup "$@" ;;
    backup-delete) cmd_backup_delete "$@" ;;
    restore)       cmd_restore "$@" ;;
    restore-scoped) cmd_restore_scoped "$@" ;;
    post-restore)  cmd_post_restore "$@" ;;
    recover-snapshot) cmd_recover_snapshot "$@" ;;
    halt)          cmd_halt "$@" ;;
    delegations)   cmd_delegations "$@" ;;
    report)        cmd_report "$@" ;;
    breakglass)    cmd_breakglass "$@" ;;
    startgate)     cmd_startgate "$@" ;;
    npm-provision) cmd_npm_provision "$@" ;;
    proxy)         cmd_proxy "$@" ;;
    keycloak-role-sync) cmd_keycloak_role_sync "$@" ;;
    status)        cmd_status "$@" ;;
    doctor)        cmd_doctor "$@" ;;
    logs)          cmd_logs "$@" ;;
    support-bundle) cmd_support_bundle "$@" ;;
    metrics)       cmd_metrics "$@" ;;
    hostnames)     cmd_hostnames "$@" ;;
    topology)      cmd_topology "$@" ;;
    node)          cmd_node "$@" ;;
    node-shell)    cmd_node_shell "$@" ;;
    librechat)     cmd_librechat "$@" ;;
    audit)         cmd_audit "$@" ;;
    pairing)       cmd_pairing "$@" ;;
    addon)
        sub="${1:-}"; shift || true
        case "$sub" in
            install)   cmd_addon_install "$@" ;;
            start)     cmd_addon_start "$@" ;;
            upgrade)   cmd_addon_upgrade "$@" ;;
            update)    error "No 'addon update' command. Did you mean 'papaia-ctl addon upgrade'?"; exit 2 ;;
            rollback)  cmd_addon_rollback "$@" ;;
            list)      cmd_addon_list "$@" ;;
            check)     cmd_addon_check "$@" ;;
            components) cmd_addon_components "$@" ;;
            stop)      cmd_addon_stop "$@" ;;
            remove)    cmd_addon_remove "$@" ;;
            uninstall) cmd_addon_uninstall "$@" ;;
            run)       cmd_addon_run "$@" ;;
            chat)      cmd_addon_chat "$@" ;;
            *) error "Unknown 'addon' subcommand: '${sub:-<none>}'. Valid: install, start, upgrade, rollback, list, check, components, stop, remove, uninstall, run, chat."; exit 2 ;;
        esac
        ;;
    realm)
        sub="${1:-}"; shift || true
        case "$sub" in
            sync)      cmd_realm_sync "$@" ;;
            keys)      cmd_realm_keys "$@" ;;
            *) error "Unknown 'realm' subcommand: '${sub:-<none>}'. Valid: sync, keys."; exit 2 ;;
        esac
        ;;
    catalog)
        sub="${1:-}"; shift || true
        case "$sub" in
            render)    cmd_catalog_render "$@" ;;
            *) error "Unknown 'catalog' subcommand: '${sub:-<none>}'. Valid: render."; exit 2 ;;
        esac
        ;;
    settings)      cmd_settings "$@" ;;
    privacy-pack)  cmd_privacy_pack "$@" ;;
    person)        cmd_person "$@" ;;
    service-account) cmd_service_account "$@" ;;
    certs)         cmd_certs "$@" ;;
    secrets)
        sub="${1:-}"; shift || true
        case "$sub" in
            rotate)    cmd_secrets_rotate "$@" ;;
            *) error "Unknown 'secrets' subcommand: '${sub:-<none>}'. Valid: rotate."; exit 2 ;;
        esac
        ;;
    suite)
        sub="${1:-}"; shift || true
        case "$sub" in
            verify)    cmd_suite_verify "$@" ;;
            *) error "Unknown 'suite' subcommand: '${sub:-<none>}'. Valid: verify."; exit 2 ;;
        esac
        ;;
    help|-h|--help) usage ;;
    *) error "Unknown command: $cmd"; usage; exit 2 ;;
esac
}

cmd="$1"; shift || true
# --test-trust-anchor=FILE is taken out here and applies to this one command only
# (lib/sh/trust.sh); without it the command runs as it always did.
_dispatch_with_test_anchor _dispatch "$cmd" "$@"

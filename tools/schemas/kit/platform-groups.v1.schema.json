{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.papaia.dev/platform-groups.v1.schema.json",
  "title": "papaia platform group list",
  "description": "Groups of the platform realm offered for sharing, rendered by the core next to services.json as <PAPAIA_CONFIG_DIR>/platform/groups.json and mounted read-only. Carries no member data and no personal data. Normative description: contract/platform-services.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "generated_at", "groups"],
  "properties": {
    "format": {"const": "papaia.platform-groups/1"},
    "generated_at": {"$ref": "#/$defs/Timestamp"},
    "groups": {
      "type": "array",
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/Group"}
    }
  },
  "$defs": {
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$(?!\\n)",
      "description": "UTC, RFC 3339."
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "en"],
      "properties": {
        "de": {"type": "string", "minLength": 1, "maxLength": 200},
        "en": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "Group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "display_name", "technical"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}$(?!\\n)",
          "description": "Group id of the identity provider; principals of a share refer to it."
        },
        "path": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(/[^/\\u0000-\\u001f\\u007f]+)+$(?!\\n)",
          "description": "Full group path, for example /sales/south."
        },
        "display_name": {"$ref": "#/$defs/Text"},
        "technical": {
          "type": "boolean",
          "description": "true for role bundles and groups with the attribute papaia.technical=true; consumers never offer them for sharing."
        }
      }
    }
  }
}

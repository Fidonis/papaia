{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "papaia-access-report-inputs.schema.json",
  "title": "Inputs of the permission report (service/access-report-inputs.json of papaia-audit)",
  "description": "Written by papaia-ctl on realm sync and start into $PAPAIA_CONFIG_DIR/infra/audit/service/; papaia-audit reads it read-only on every build of the permission report. It holds what the report account (view-users only) cannot read itself. No secret and no credential is part of it.",
  "type": "object",
  "required": [
    "format", "written_at", "module_clients", "service_accounts", "pairings",
    "breakglass_ids", "sessions", "recertification_days"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "papaia.access-report-inputs/1"},
    "written_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "module_clients": {
      "description": "The managed clients persons sign in to (their offline sessions are the stored delegations).",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "client_id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$"},
          "client_id": {"$ref": "#/$defs/name"}
        }
      }
    },
    "service_accounts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "module", "owner_sub", "deputy_sub", "audiences", "effects"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^svc-[a-z][a-z0-9]*-[a-z0-9]+(-[a-z0-9]+)*$"},
          "module": {"oneOf": [{"$ref": "#/$defs/name"}, {"type": "null"}]},
          "owner_sub": {"$ref": "#/$defs/subject"},
          "deputy_sub": {"$ref": "#/$defs/subject"},
          "audiences": {"type": "array", "items": {"$ref": "#/$defs/name"}, "uniqueItems": true},
          "effects": {"type": "array", "items": {"type": "string", "maxLength": 16}, "uniqueItems": true}
        }
      }
    },
    "pairings": {
      "description": "Confirmed exchange rights: the operator's pairings (security/pairings.yaml) and the platform pairings of the realm sync (requested and confirmed by platform).",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["client", "audience", "effects", "requested_by", "confirmed_by"],
        "additionalProperties": false,
        "properties": {
          "client": {"$ref": "#/$defs/name"},
          "audience": {"$ref": "#/$defs/name"},
          "effects": {"type": "array", "items": {"enum": ["r", "w", "d", "x"]}, "uniqueItems": true},
          "requested_by": {"$ref": "#/$defs/person"},
          "confirmed_by": {"$ref": "#/$defs/person"}
        }
      }
    },
    "breakglass_ids": {
      "description": "The id of the emergency account papaia-ctl recorded.",
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$"},
      "uniqueItems": true
    },
    "sessions": {
      "type": "object",
      "required": ["offline", "delegations"],
      "additionalProperties": false,
      "properties": {
        "offline": {
          "description": "Offline-session limits of the realm in days (max_age_days null: no maximum age).",
          "type": "object",
          "required": ["idle_days", "max_age_days"],
          "additionalProperties": false,
          "properties": {
            "idle_days": {"type": "integer", "minimum": 0, "maximum": 36500},
            "max_age_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 36500}
          }
        },
        "delegations": {
          "description": "The delegation lifetime in effect (papaia-ctl delegations lifetime --json).",
          "type": "object"
        }
      }
    },
    "recertification_days": {"type": "integer", "minimum": 30, "maximum": 730}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "subject": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@|+-]{0,254}$"},
    "person": {"type": ["string", "null"], "pattern": "^(host:[A-Za-z0-9._][A-Za-z0-9._@-]{0,63}|platform)$"}
  }
}

# ═══════════════════════════════════════════════════════════════════════════
# papAIa — Personal area · environment variables   (profile: me)
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════
#
# me-web shows the modules listed in $PAPAIA_CONFIG_DIR/personal-settings/registry.yaml;
# nothing here changes WHICH modules appear, only how the area runs.

# OIDC client secret of papaia-me — synced from KC_ME_CLIENT_SECRET during setup;
# do not edit manually.
ME_OIDC_CLIENT_SECRET=GENERATE_ME_OIDC_CLIENT_SECRET

# Signing key of the session cookie — generated by papaia-ctl setup.
ME_SESSION_SECRET=GENERATE_ME_SESSION_SECRET

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

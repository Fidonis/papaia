# ═══════════════════════════════════════════════════════════════════════════
# papAIa — Mein Bereich · environment variables   (profile: me)
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════
#
# Exactly the variables src/infra/me/docker-compose.yml interpolates beyond the root
# src/.env (checked by `python -m lib.me_profile check`). Which modules appear in the
# area comes from $PAPAIA_CONFIG_DIR/personal-settings/registry.yaml, not from here.

# Client secret of papaia-me (confidential client, token exchange per module) —
# generated during setup; do not edit manually.
ME_OIDC_CLIENT_SECRET=GENERATE_ME_OIDC_CLIENT_SECRET

# Signing key of the session cookie, at least 32 bytes — generated during setup.
ME_SESSION_SECRET=GENERATE_ME_SESSION_SECRET

# Password of the database prefs-db — generated during setup. It reaches prefs and
# prefs-db as a file under /run/secrets, never as a variable of either service.
PREFS_DB_PASSWORD=GENERATE_PREFS_DB_PASSWORD

# Sign-in details beyond the shared OIDC_* variables of src/.env. Empty: derived from
# the issuer (end-session endpoint, back channel on the issuer itself).
ME_OIDC_LOGOUT_URL=
ME_OIDC_INTERNAL_ISSUER=
ME_OIDC_SCOPE=openid profile
# Account console of the sign-in service; empty: <issuer>/account.
ME_ACCOUNT_URL=

# Stricter than the platform only: empty follows PAPAIA_SECURITY_PROFILE, `kritis`
# turns off plain-http module calls for the area even under `standard`.
ME_SECURITY_PROFILE=

# Partial operation: a module that does not answer within ME_MODULE_TIMEOUT seconds is
# shown as unreachable; an export per module is bounded in time and size.
ME_MODULE_TIMEOUT=2
ME_EXPORT_TIMEOUT=10
ME_EXPORT_MAX_BYTES=16777216
# Port of a module's API when its declaration names none.
ME_MODULE_PORT=8080
# Language of the area for a person without a saved language: de | en
ME_DEFAULT_LANG=de
# Name of the installation in page titles while the catalog carries no branding
# (at most 60 characters); empty: the name the image ships.
ME_INSTALLATION_NAME=
# Log level of me-web: DEBUG | INFO | WARNING | ERROR
ME_LOG_LEVEL=INFO

# With the profile `connections` on as well, me-web calls the connection registry as the
# person client papaia-me, with mutual TLS. Nothing is set here: papaia-ctl issues me-web a
# client certificate of the platform PKI into $PAPAIA_PKI_DIR/core/me-web/ (read-only,
# uid 10001) and hands the paths over in the generated override
# docker-compose.me-connections.override.yml:
#   ME_CONNECTIONS_CA_FILE=/run/papaia/tls/ca.crt
#   ME_CONNECTIONS_CERT_FILE=/run/papaia/tls/client.crt
#   ME_CONNECTIONS_KEY_FILE=/run/papaia/tls/client.key
# Me gets a token for the registry only after the pairing papaia-me -> papaia-connections
# is confirmed and approved by a second person (README, "Mein Bereich").

# Defaults of a person who never saved a preference. The time zone is also the one
# me-web resets to ("Auf Standard zurücksetzen").
PREFS_DEFAULT_TIME_ZONE=Europe/Berlin
# mail | chat_window
PREFS_DEFAULT_CHANNEL=mail
# Language of the store's messages: de | en
PREFS_LANG=de
# Notification channels switched off for the whole installation, comma-separated:
# chat_window, mail. Empty: both on. Switch mail off while the installation has no mail
# relay (profile smtp); a person then cannot choose it.
PREFS_DISABLED_CHANNELS=

# Test message by mail (page "Benachrichtigungen"): derived by setup and `start`, do not
# edit. With the profiles me and smtp on: the relay's name (smtp-relay), its sender address
# (SMTP_RELAY_FROM_ADDRESS, inside SMTP_RELAY_SENDER_DOMAINS), the name of the installation
# (the one every mail is sent under) and the https link to the page, from ME_PUBLIC_URL.
# Without smtp all are empty and the mail test answers that the mail exit is not set up.
# A sender outside the sender domains or an address of Mein Bereich without https stops
# setup and start with the variable named.
PREFS_SMTP_HOST=
PREFS_MAIL_FROM=
PREFS_INSTALLATION_NAME=
PREFS_NOTIFICATIONS_URL=

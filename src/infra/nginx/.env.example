# ═══════════════════════════════════════════════════════════════════════════
# papAIa — Nginx Proxy Manager · environment variables
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════
# The remaining Nginx Proxy Manager variables (NPM_ADMIN_EXT_PORT,
# NPM_ADMIN_HOST, OAUTH2_PROXY_*, OIDC_*) are configured in the root
# .env.example — they are shared with other modules.
#
# Everything below is consumed by docker compose ${VAR} expansion in this
# module's docker-compose.yml (Compose merges this file into the interpolation
# scope for the included service), not by `env_file:`.

# Credentials for the bundled NPM admin account — used by `papaia-ctl` to
# provision proxy hosts automatically on first start. Set as INITIAL_ADMIN_*
# in the NPM container (honoured only on first boot; ignored on re-starts).
NPM_ADMIN_EMAIL=admin@papaia.local
NPM_ADMIN_PASSWORD=GENERATE_NPM_ADMIN_PASSWORD

# Localhost-only port binding for direct NPM API access by papaia-ctl.
# Port 81 (NPM admin) is not published externally; this binding is restricted
# to 127.0.0.1 so only processes on the same host can reach it.
NPM_API_LOCAL_PORT=8181

# ═══════════════════════════════════════════════════════════════════════════
# papAIa — Connection registry (profile `connections`, ADR 0021)
# ═══════════════════════════════════════════════════════════════════════════
# Copied to $PAPAIA_CONFIG_DIR/infra/connections/.env by `papaia-ctl setup`.

# Two database logins. The owner of the schema is used only by the one-shot
# container connections-migrate; the registry connects with its own login, which
# holds data rights only. Both generated once and kept: a new value locks the
# registry out of its own database.
CONNECTIONS_OWNER_DB_PASSWORD=GENERATE_CONNECTIONS_OWNER_DB_PASSWORD
CONNECTIONS_SERVICE_DB_PASSWORD=GENERATE_CONNECTIONS_SERVICE_DB_PASSWORD

# OIDC clients whose tokens the registry accepts, comma-separated:
#   person   clients a person signs in with (e.g. connections-web,flow-console)
#   service  client=service pairs of service accounts (e.g. flow-control=flow);
#            a service needs a mandate of the person
#   delegate gates that bring the person's own token (e.g. assist-gate=assist)
# Empty in the core: a module that uses the registry names its entries. papaia-me
# (Mein Bereich) is added by papaia-ctl while the profile `me` is on and taken out while
# it is off; the value here is kept as it is.
CONNECTIONS_PERSON_CLIENTS=
CONNECTIONS_SERVICE_CLIENTS=
CONNECTIONS_DELEGATE_CLIENTS=
# Days after which a mandate ends unless the person is active (empty: the
# registry's default; kritis: at most 30).
CONNECTIONS_MANDATE_DAYS=
# Services that never use an account without the person's own token.
CONNECTIONS_PERSON_TOKEN_SERVICES=
# A service asking for credentials of more distinct persons within an hour is
# held until an administrator releases it. 0 switches the brake off.
CONNECTIONS_USE_PERSONS_PER_HOUR=500

# standard | kritis. Empty: the platform-wide PAPAIA_SECURITY_PROFILE. The
# registry may be stricter than the platform, never weaker.
CONNECTIONS_PROFILE=

# Mutual TLS: the CA whose client certificates the registry asks every caller
# for, inside the container. Default: the platform CA of the PKI. Empty allows
# one-sided TLS (refused under kritis).
CONNECTIONS_TLS_CLIENT_CA=/run/papaia/tls/ca.crt

# Where the master key lives:
#   file     key files in the volume connections-keys (default; refused under kritis)
#   openbao  the Transit engine of OpenBao
#   pkcs11   a hardware security module (keys made beforehand by the key ceremony,
#            python -m papaia_connections.main init-pkcs11-keys)
# The token file, the PIN file and the PKCS#11 module are paths inside the
# container; mount them read-only through a compose override.
CONNECTIONS_KEY_PROVIDER=file
CONNECTIONS_OPENBAO_URL=
CONNECTIONS_OPENBAO_TOKEN_FILE=
CONNECTIONS_PKCS11_MODULE=
CONNECTIONS_PKCS11_TOKEN_LABEL=
CONNECTIONS_PKCS11_PIN_FILE=
CONNECTIONS_PKCS11_KEY_LABEL=
CONNECTIONS_PKCS11_JOURNAL_KEY_LABEL=

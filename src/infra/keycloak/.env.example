# ═══════════════════════════════════════════════════════════════════════════
# papAIa — Keycloak · environment variables
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════

# --- Database ---
KC_DB_USER=papaia_keycloak
KC_DB_PASSWORD=keycloak

# --- Admin Bootstrap ---
# Master-realm admin, created once on Keycloak's first start. papaia-ctl setup
# fills this with a random value and keeps it sticky across re-runs. Editing it
# here after that first start has no effect -- the account already exists; rotate
# it from the admin console instead.
KC_ADMIN_PASSWORD=GENERATE_KC_ADMIN_PASSWORD

# --- Realm administrator ---
# Password of the account `admin` (realm role papaia-admin) in the papaia realm.
# papaia-ctl setup generates it; the rendered realm gives it to `admin` as a
# temporary password that must be changed at the first sign-in. Read it with
#   grep KC_REALM_ADMIN_PASSWORD "$PAPAIA_CONFIG_DIR/infra/keycloak/.env" | cut -d= -f2
# On an existing installation, `papaia-ctl realm sync` sets it as the temporary
# password of an `admin` that still has the old template password `admin`, and
# disables `testuser` while it still has the password `testuser`.
KC_REALM_ADMIN_PASSWORD=GENERATE_KC_REALM_ADMIN_PASSWORD

# --- Client Secrets ---
# Baked into realm-import/papaia-realm.json before Keycloak reads it, by
# render_core.bake_realm_secrets() — replace each placeholder with a secure
# random value, e.g.: openssl rand -hex 24
#
# Core clients only. Addon clients (paperless, ...) register their own OIDC
# client and generate their own secret during addon installation — keeping a
# placeholder here would produce a random value nothing ever reads.
KC_LIBRECHAT_CLIENT_SECRET=GENERATE_KC_LIBRECHAT_CLIENT_SECRET
KC_LITELLM_CLIENT_SECRET=GENERATE_KC_LITELLM_CLIENT_SECRET
KC_OAUTH2_PROXY_CLIENT_SECRET=GENERATE_KC_OAUTH2_PROXY_CLIENT_SECRET
KC_LOCALAI_CLIENT_SECRET=GENERATE_KC_LOCALAI_CLIENT_SECRET
KC_MANAGER_CLIENT_SECRET=GENERATE_KC_MANAGER_CLIENT_SECRET
# The RAG system's MCP clients mcp-qdrant and mcp-qdrant-ingest (profile: rag) are
# bearer-only resource servers and need no secret.

# --- Realm sync ---
# Secret of the service account svc-papaia-realm-sync in the papaia realm, which
# `papaia-ctl realm sync` makes its changes with. It holds the realm-management roles
# manage-clients and manage-realm of this realm (nothing in the master realm).
# manage-realm can be grown into realm-admin of the papaia realm, so this is a second
# secret of that reach: protect it like KC_ADMIN_PASSWORD. It does not replace the
# master admin: every sync and every check also signs in with KC_ADMIN_PASSWORD to
# check the account's rights and realign them and this secret.
# papaia-ctl setup fills it in.
KC_REALM_SYNC_CLIENT_SECRET=GENERATE_KC_REALM_SYNC_CLIENT_SECRET

# --- Offline sessions ---
# Limits of the offline sessions in the papaia realm (the delegations of Flow and the
# assistant), in whole days. Empty: the limit of the security profile
# (PAPAIA_SECURITY_PROFILE in the root .env): standard 30 / 180, kritis 7 / 30. A value
# may only lower that limit; a higher one stops `papaia-ctl realm sync` and the render.
# For an installation with a federated identity provider, 7 / 30 is recommended.
KC_OFFLINE_SESSION_IDLE_DAYS=
KC_OFFLINE_SESSION_MAX_DAYS=

# --- Hostname ---
# Public URL of Keycloak written into token "iss" claims and OIDC discovery docs.
# Must be reachable from BOTH the browser AND other Docker containers.
#
# Default uses host.docker.internal with HTTPS (KEYCLOAK_EXT_PORT → container 8443):
#   - macOS / Windows Docker Desktop: works out-of-the-box
#   - Linux: add "127.0.0.1 host.docker.internal" to /etc/hosts
# Trust the local CA cert (generated by papaia-ctl setup) in your browser to
# access Keycloak without a certificate warning.
#
# For production behind a reverse proxy that terminates TLS, set this to your
# real domain (the reverse proxy handles the browser-visible cert):
#   KC_HOSTNAME=https://auth.yourdomain.com
KC_HOSTNAME=https://host.docker.internal:8110

# --- Reverse-proxy mode ---
# Required when an edge proxy (Caddy / Traefik / nginx) terminates TLS in
# front of Keycloak and forwards plain HTTP. Without this, Keycloak logs
#   WARN  Likely misconfiguration detected. When using an edge proxy, you
#         must use `proxy-headers`.
#   WARN  Non-secure context detected; cookies are not secured […]
# and emits non-Secure session cookies, which the browser then drops on
# the cross-origin OIDC POST → "Unknown OAuth error" at login.
#
# Set to empty when running Keycloak directly exposed without a proxy.
KC_PROXY_HEADERS=xforwarded

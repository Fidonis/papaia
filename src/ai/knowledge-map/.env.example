# ═══════════════════════════════════════════════════════════════════════════
# papAIa — Knowledge map · environment variables   (profile: knowledge-map)
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════
#
# knowledge-map-mcp serves the rendered map from
# $PAPAIA_CONFIG_DIR/knowledge-map/. The map content comes from the
# `knowledge:` declarations of active add-ons and core modules, the connected
# MCP servers and chat agents (inventory), the operator's own declarations in
# overlay/knowledge-map/sources.yaml and the overrides in
# overlay/knowledge-map/overrides.yaml — nothing here changes WHAT is on the
# map, only how the service runs.

# API key for embedding calls to LiteLLM — synced from LITELLM_MASTER_KEY during
# setup; do not edit manually.
KM_EMBEDDING_API_KEY=GENERATE_KM_EMBEDDING_API_KEY

# Embedding model used for routing. Should exist in LiteLLM; the local default
# pairs with the localai profile. The endpoint URL is fixed to LiteLLM by the
# compose file — when the model is missing or a call fails, the server routes
# that request with its built-in lexical fallback (weaker ranking, logged as a
# warning) instead of erroring out.
# KM_EMBEDDING_MODEL=nomic-embed-text

# Routing calibration — tune against the deployment's gold set before trusting
# abstentions (see the knowledge-map documentation).
# Relevance floor below which the server abstains instead of ranking noise.
# KM_ABSTENTION_THRESHOLD=0.25
# Separate floor used while the lexical fallback ranks (embedding outage) —
# its score space differs from the embedder's; responses are marked degraded.
# KM_LEXICAL_ABSTENTION_THRESHOLD=0.2
# Top-2 margin reported as ambiguous instead of silently resolved.
# KM_AMBIGUITY_MARGIN=0.05

# Bearer token of the admin API the management interface uses (map view,
# routing simulation, usage statistics, gold-set runs, refinement
# suggestions). Generated during setup; without it the admin API is off.
KM_ADMIN_TOKEN=GENERATE_KM_ADMIN_TOKEN

# Connected MCP servers that describe no knowledge are routed as "unverified"
# candidates (true) or only named when the map abstains (false).
# KM_ROUTE_UNDECLARED=true

# Routing telemetry: need texts can derive from user questions and are
# personal data. Raw records are deleted after this many days; 0 = no
# telemetry at all.
# KM_TELEMETRY_RETENTION_DAYS=30
# off = keep no need texts (counts only) | aggregate = keep them for
# refinement suggestions, shown only aggregated and masked | full
# KM_LEARNING_MODE=aggregate

# Further audiences whose tokens are accepted (comma-separated), e.g. a team
# assistant's resource-server client, and an optional allowlist of the
# clients tokens may be issued to. Prefer a token exchange to
# mcp-knowledge-map over widening the audiences.
# KM_EXTRA_AUDIENCES=
# KM_ALLOWED_AZP=

# How long the Keycloak signing keys are cached, in seconds.
# KM_OIDC_JWKS_CACHE_TTL=3600

# Log level: DEBUG | INFO | WARNING | ERROR
# KM_LOG_LEVEL=INFO

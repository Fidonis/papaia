# ═══════════════════════════════════════════════════════════════════════════
# papAIa — LocalAI · environment variables
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════
# NOTE — this file has a double role, and the two halves are not interchangeable:
#
#   * LOCALAI_HEALTHCHECK_* are read by docker compose ${VAR} expansion (Compose
#     merges this file into the interpolation scope for the included service).
#   * Everything else reaches the container through `env_file:` as process env.
#
# A variable of the second kind must NOT be added to the `environment:` block in
# docker-compose.yml: `environment:` wins over `env_file:`, and the interpolation
# scope would resolve it to an empty string, silently blanking the real value.
# LOCALAI_OIDC_CLIENT_SECRET is the case to watch — see the comment on the
# localai service in docker-compose.yml.
#
# The inverse is also true: variables that ARE in the `environment:` block are
# controlled by the ROOT .env and cannot be changed here — edits to this file
# have no effect on them. The affected variables are:
#   LOCALAI_BASE_URL       → set from LOCALAI_PUBLIC_URL in the root .env
#   LOCALAI_OIDC_ISSUER    → set from OIDC_ISSUER in the root .env
#   LOCALAI_OIDC_CLIENT_ID → hardcoded to "localai" in docker-compose.yml
# To change LOCALAI_BASE_URL, update LOCALAI_PUBLIC_URL via
# `papaia-ctl setup --localai-host=<new-url>` and restart LocalAI.

# Logging
LOCALAI_LOG_LEVEL=info
LOCALAI_DEBUG=false

# Healthcheck — increase start_period when downloading large GPU models on first start
LOCALAI_HEALTHCHECK_INTERVAL=30s
LOCALAI_HEALTHCHECK_TIMEOUT=10s
LOCALAI_HEALTHCHECK_RETRIES=5
LOCALAI_HEALTHCHECK_START_PERIOD=40s

# OIDC — synced from KC_LOCALAI_CLIENT_SECRET during setup; do not edit manually
LOCALAI_OIDC_CLIENT_SECRET=GENERATE_LOCALAI_OIDC_CLIENT_SECRET

# Auto-promote this email to LocalAI admin on first SSO login (optional).
# Set to the email of your Keycloak admin user, e.g. admin@papaia.lan
LOCALAI_ADMIN_EMAIL=
LOCALAI_DISABLE_LOCAL_AUTH=true


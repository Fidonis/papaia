# ═══════════════════════════════════════════════════════════════════════════
# papAIa — Voice · environment variables   (profile: voice)
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════
#
# speaches (speech-to-text) and chatterbox (text-to-speech). Neither service
# publishes a host port; both are reached through LiteLLM (models `voice-stt`
# and `voice-tts`).
#
# The TTS server is configured through ai/voice/chatterbox.yaml (rendered
# through the overlay mechanism), not through environment variables.

# --- Shared ---
# Bearer key the STT engine requires on every request; LiteLLM signs its
# voice-stt calls with it (synced to ai/litellm/.env during setup; do not edit
# manually). The TTS engine has no auth of its own — see ADR 0011.
VOICE_API_KEY=GENERATE_VOICE_API_KEY

# --- Speech-to-text (speaches) ---
# The faster-whisper model the init container installs on first start
# (~1.6 GB). CHANGING IT IS A TWO-PLACE EDIT: the LiteLLM route voice-stt
# names the same id per request (integration/ai/litellm/config.yaml — change
# that through the overlay), and speaches serves only installed models.
# German finetune: primeline/whisper-large-v3-turbo-german (CTranslate2 form);
# tight memory: Systran/faster-whisper-small.
# VOICE_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2

# Quantization for faster-whisper. int8 halves memory at no noticeable quality
# loss; float32 is the conservative fallback on CPUs without int8 support.
# VOICE_STT_COMPUTE_TYPE=int8

# 0 = use all cores. On a host that shares cores with LLM inference, cap it
# (e.g. 4) so a dictation burst cannot starve the rest of the stack.
# VOICE_STT_CPU_THREADS=0

# Seconds an idle model stays in memory before it is unloaded (-1 = never,
# 0 = immediately). The default keeps ~1.5 GB allocated for five minutes
# after the last transcription.
# VOICE_STT_MODEL_TTL=300

# One of: debug, info, warning, error
# VOICE_STT_LOG_LEVEL=info

# Grace period before the container counts as unhealthy. The first request
# after a fresh install downloads the model (~1.6 GB).
# VOICE_STT_HEALTHCHECK_START_PERIOD=30s

# --- Text-to-speech (chatterbox) ---
# Hard memory ceiling for the TTS container. The multilingual model stays
# resident once loaded (~4-6 GB); the limit makes an out-of-memory condition
# kill this container instead of a random other one.
# VOICE_TTS_MEM_LIMIT=8g

# The first start downloads ~3.2 GB of model weights before the server
# answers; raise this on a slow connection.
# VOICE_TTS_HEALTHCHECK_START_PERIOD=180s

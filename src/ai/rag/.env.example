# ═══════════════════════════════════════════════════════════════════════════
# papAIa — RAG system · environment variables   (profile: rag)
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════
#
# Qdrant, qdrant-mcp and qdrant-ingest. The browser-facing Qdrant URL and the host
# ports (QDRANT_PUBLIC_URL, QDRANT_EXT_PORT, QDRANT_INGEST_EXT_PORT) live in the
# root .env, see src/.env.example.
#
# qdrant-ingest receives this whole file as its container environment
# (env_file:), so every QI_* key below reaches it unchanged. Keys that
# qdrant-ingest already gets from docker-compose.yml (OIDC_ISSUER,
# QI_EMBEDDING_API_URL, QI_TIKA_URL, QI_HTTP_*, QI_JOBS_FILE, QI_CONNECTIONS_FILE,
# QI_EMBED_META_COLLECTION, QI_RBAC_ACL_COLLECTION, QI_OIDC_OPERATOR_ROLE)
# must not be set here: environment: would win and blank them.

# --- Qdrant ---
# Qdrant's api-key and, at the same time, the HS256 secret qdrant-mcp signs its
# per-request tokens with. Generated by papaia-ctl setup; do not edit manually.
# papaia-manager stores the same value, encrypted, as the api-key of the connection
# `default` to http://qdrant:6333 (Connections page).
QDRANT_JWT_SECRET=GENERATE_QDRANT_JWT_SECRET

# --- System collections (qdrant-mcp and qdrant-ingest) ---
# The metadata collection holds one record per data collection with its embedding
# model and dimension; the ACL collection holds the role grants. qdrant-mcp and
# qdrant-ingest must use the same two, so one key each reaches both services (the
# QI_ names the ingester uses are derived from them and cannot be set here).
# Renaming on an installation that already holds data leaves the old collections
# where they are; see src/ai/README.md.
# EMBEDDING_META_COLLECTION=_collection_meta
# RBAC_ACL_COLLECTION=_rbac_acl
# The role that gates the ingester's MCP tools is fixed to qdrant-ingest-operator:
# the realm template and the papaia-admin role name it, so it cannot be changed here.

# --- qdrant-mcp ---
# API key for embedding calls to LiteLLM — synced from LITELLM_MASTER_KEY during
# setup; do not edit manually.
QDRANT_MCP_EMBEDDING_API_KEY=GENERATE_QDRANT_MCP_EMBEDDING_API_KEY
# How long the Keycloak signing keys are cached, in seconds.
# QDRANT_MCP_OIDC_JWKS_CACHE_TTL=3600
# Lifetime of the Qdrant token derived per request, in seconds (minimum 60).
# QDRANT_MCP_QDRANT_JWT_TTL=3600
# How long a caller's ACL is cached, in seconds (minimum 1).
# QDRANT_MCP_RBAC_ACL_CACHE_TTL=60
# Lifetime of the service token used to read the ACL collection, in seconds (minimum 10).
# QDRANT_MCP_RBAC_SERVICE_TOKEN_TTL=300
# Log level: DEBUG | INFO | WARNING | ERROR
# QDRANT_MCP_LOG_LEVEL=INFO

# --- qdrant-ingest ---
# API key for embedding calls to LiteLLM — synced from LITELLM_MASTER_KEY during
# setup; do not edit manually. The core ships no models, so add an embedding
# model to LiteLLM before the first ingest run.
QI_EMBEDDING_API_KEY=GENERATE_QI_EMBEDDING_API_KEY
# Encrypts the Qdrant api-keys stored in connections.yaml and the source credentials
# stored in secrets.yaml. Losing it makes the stored values unreadable (they have to
# be entered again).
QI_CONNECTIONS_SECRET=GENERATE_QI_CONNECTIONS_SECRET
# Static bearer token of the REST API (/v1); papaia-manager uses it to start and
# follow runs.
QI_API_TOKEN=GENERATE_QI_API_TOKEN

# Directory with the documents for sources of type 'local', mounted read-only at
# /data/local. Defaults to ${PAPAIA_CONFIG_DIR}/ai/rag/documents, which setup creates.
# QI_LOCAL_MOUNT=/srv/documents
# Heap size of the Tika extractor. Scanned-PDF OCR needs the -full image and more.
# QI_TIKA_HEAP=2g

# Secrets for the ingest sources of your own, referenced in jobs.yaml as
# ${env:QI_SECRET_<NAME>}. Only names matching QI_SECRET_[A-Z0-9_]+ resolve.
# QI_SECRET_S3_ACCESS_KEY=
# QI_SECRET_S3_SECRET_KEY=

# Further tuning (scheduling, extraction, embedding batches, metrics) is
# documented in the qdrant-ingest repository, docs/operations.md. Uncomment and
# set a QI_* key here to override its default.
# QI_TIMEZONE=UTC
# QI_MAX_CONCURRENT_JOBS=2
# QI_TIKA_OCR_LANGUAGE=deu+eng
# QI_LOG_LEVEL=INFO

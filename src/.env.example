# ═══════════════════════════════════════════════════════════════════════════
# papAIa — Global Stack Configuration · environment variables
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════

# papAIa stack version — do not edit
PAPAIA_VERSION=

COMPOSE_PROJECT_NAME=papaia
# Only the default modules are listed here. Add the modules you enable
# to this comma-separated list (e.g. homepage / searxng / localai).
# Listing a profile whose .env file has not been generated breaks
# `docker compose config` with "env file not found".
COMPOSE_PROFILES=keycloak,nginx,oauth2-proxy,librechat,litellm
DOCKER_NETWORK="papaia-net"

# =============================================================================
# Externalised service configuration directory
# =============================================================================
# Path on the host where customer-specific service configuration lives. The
# directory layout inside it MIRRORS the layout under src/ (e.g.
# ai/librechat/librechat.yaml, infra/keycloak/keycloak.conf,
# services/homepage/config/services.yaml, ...).
#
# All bind-mounted configuration files that used to be sourced from inside
# the cloned repo (`./<file>` in src/**/docker-compose.yml) are now sourced
# from ${PAPAIA_CONFIG_DIR}/<mirrored-path>. The repo ships canonical
# defaults under src/; the running stack only ever reads from this directory.
# Customer edits therefore never produce a git diff in the checkout.
#
# IMPORTANT — set this to an ABSOLUTE PATH. Docker Compose `include:`d files
# resolve relative paths against their OWN directory, so a relative value
# like "./config" would resolve differently per service and not work.
#
# The directory is populated and kept up to date by the orchestrator:
#     tools/papaia-ctl setup                # seeds it from the shipped defaults
#     tools/papaia-ctl start                # re-renders it on every start
# Both are non-destructive: existing files in the target are kept.
#
# `src/sync-config.sh` is a low-level fallback for scripting scenarios only.
# It is not part of the normal operating path.
#
# Examples:
#   Linux:   PAPAIA_CONFIG_DIR=/srv/papaia/config
#   macOS:   PAPAIA_CONFIG_DIR=/Users/<you>/papaia-config
#   Windows: PAPAIA_CONFIG_DIR=C:/papaia-config   (forward slashes)
PAPAIA_CONFIG_DIR=/srv/papaia/config

# Parent directory that contains the papaia checkout and addons.
# Required by the manager profile (profile `manager`) — it mounts this directory
# inside the container at the same path (path-parity) so the manager can import
# lib.* from ${PAPAIA_WORKSPACE_DIR}/papaia/tools and invoke papaia-ctl.
# `papaia-ctl setup` overwrites this placeholder with the parent of the actual
# checkout (the directory containing this `papaia` clone), so you normally never
# set it by hand. A value you edit in yourself is kept as-is.
PAPAIA_WORKSPACE_DIR=/srv/papaia/workspace

# Default target directory for `papaia-ctl backup`. Each run writes a
# timestamped subdirectory here; the restore-point catalogue (backup.yaml) and
# the operation log (backup.log) live directly in it, so pointing --backup-dir
# somewhere else moves the whole set together.
# Also required by the manager profile (profile `manager`), which mounts this
# directory at the same path (path-parity) so the value it passes to
# `papaia-ctl --backup-dir` means the same inside the container as on the host.
# `papaia-ctl setup` overwrites this placeholder with ${PAPAIA_WORKSPACE_DIR}/backup,
# unless --backup-dir=PATH was passed or a real value is already set here — a
# value you edit in yourself is kept as-is.
PAPAIA_BACKUP_DIR=/srv/papaia/backup

# GID that owns /var/run/docker.sock on this host.  Required by the manager
# profile so the non-root 'app' user can reach the Docker API.  Discover with:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine \
#     stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Host user IDs — `papaia-ctl setup` detects and stamps these automatically
# from the user running setup, so the manager container writes bind-mounted
# files (PAPAIA_CONFIG_DIR, PAPAIA_WORKSPACE_DIR) as the correct host owner.
# On macOS/Windows Docker Desktop these are ignored (Desktop remaps ownership).
UID=1000
GID=1000

# =============================================================================
# Multi-env stack bindings (network layer)
# =============================================================================
#
# HOST_IP — which host IP the container ports will be bound to.
# This is the NETWORK layer: where the Docker host listens externally.
#
#   - Default 0.0.0.0 = all interfaces (single-stack setup, behaves as before)
#   - Multi-env setup: each stack uses its own IP so two stacks with
#     identical compose files and identical ports can run in parallel on the
#     same host (e.g. via IP aliases on the host's network interface).
#
#
# Do NOT confuse with PAPAIA_HOST (see "Server base URL" block below):
#   - PAPAIA_HOST = public URL (application layer) — browser redirects,
#     OIDC issuer, OIDC callback URLs, etc. Tells the apps how they present
#     themselves to the outside world.
#   - HOST_IP    = bind address (network layer) — tells Docker which host IP
#     should expose each container port.
#
HOST_IP=0.0.0.0

# =============================================================================
# Server base URL
# =============================================================================
# Public base URL of this server — no trailing slash.
# Used to build LibreChat / LiteLLM / Homepage public URLs.
# Must be reachable from BOTH the browser AND Docker containers.
#
# macOS / Windows Docker Desktop:  http://host.docker.internal  (default)
# Linux server with a fixed IP:    http://192.168.1.100
# Production with a domain:        https://papaia.example.com
PAPAIA_HOST=http://host.docker.internal

# =============================================================================
# Auth host (Keycloak public URL)
# =============================================================================
# Public URL of the Keycloak admin console / OIDC issuer — no trailing slash.
# This is what ends up in token "iss" claims, OIDC discovery documents and
# every browser-facing login redirect, so it MUST be the URL the user types
# into the browser, not the internal IP+port the container listens on.
#
# Direct LAN setup (no reverse proxy): same host as PAPAIA_HOST plus the
#   Keycloak port, e.g.  http://192.168.1.100:8110
# Behind a reverse proxy (Caddy / Traefik / NPM) that terminates TLS for
#   Keycloak under its own FQDN:  https://auth.papaia.example.com
#   (any FQDN works — there is no enforced "auth." subdomain convention.)
#
# Set this to the public Keycloak URL (scheme, host and port included).
AUTH_HOST=https://host.docker.internal:8110

# =============================================================================
# Authentication Provider
# =============================================================================
# internal_keycloak  - Use the bundled Keycloak (default, zero config needed)
# external_oidc      - Use an existing external OIDC/IdP (Keycloak, Entra,
#                      Authentik, Okta, ...) configured via OIDC_* vars below
AUTH_PROVIDER=internal_keycloak

# =============================================================================
# OIDC / Identity Provider Configuration
# =============================================================================
# Pre-filled for the internal Keycloak default. Override for external providers.
OIDC_ISSUER=https://host.docker.internal:8110/realms/papaia
OIDC_SCOPES=openid profile email

# Split OIDC endpoint URLs for oauth2-proxy (--skip-oidc-discovery mode). These are
# provider-independent — they apply to AUTH_PROVIDER=external_oidc exactly as they do
# to the bundled Keycloak. Do not confuse them with the KC_* variables in
# infra/keycloak/.env, which configure the bundled Keycloak container itself.
#   OIDC_AUTH_URL  — browser-facing login redirect (must be reachable by the user's browser)
#   OIDC_TOKEN_URL — server-side token exchange (uses internal Docker DNS, never hit by browser)
#   OIDC_JWKS_URL  — server-side JWKS fetch (uses internal Docker DNS)
# For internal Keycloak: browser URLs use host.docker.internal (HTTPS), server URLs
# use keycloak:8443 (internal Docker DNS, HTTPS, trusted via local CA cert).
# For external OIDC: set all three to your provider's real endpoints.
OIDC_AUTH_URL=https://host.docker.internal:8110/realms/papaia/protocol/openid-connect/auth
# Token + JWKS endpoints stay on internal Docker DNS — never hit by the browser:
OIDC_TOKEN_URL=https://keycloak:8443/realms/papaia/protocol/openid-connect/token
OIDC_JWKS_URL=https://keycloak:8443/realms/papaia/protocol/openid-connect/certs

OAUTH2_PROXY_EXT_PORT=4180
OAUTH2_PROXY_CLIENT_ID=oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=GENERATE_OAUTH2_PROXY_CLIENT_SECRET
# Generate with: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=GENERATE_NEW_KEY_32BYTES_BASE64
# Marks the session cookie as Secure. Required behind HTTPS (browsers ignore
# Secure cookies over plain HTTP). Set to true when PAPAIA_HOST uses an
# https:// scheme, false otherwise.
OAUTH2_PROXY_COOKIE_SECURE=false

# ###########################################################################
# AI Services
# ###########################################################################

# ═══════════════════════════════════════════════════════════════════════════
# LibreChat - AI Chatbot
# ═══════════════════════════════════════════════════════════════════════════
LIBRECHAT_EXT_PORT=8000

# ═══════════════════════════════════════════════════════════════════════════
# LiteLLM - AI LLM Proxy
# ═══════════════════════════════════════════════════════════════════════════
LITELLM_EXT_PORT=8200
# Browser-facing LiteLLM proxy URL — derived from PAPAIA_HOST + LITELLM_EXT_PORT by
# `papaia-ctl setup`. Used for OIDC redirect URIs and NPM proxy-host provisioning.
# Override via `papaia-ctl setup --litellm-host=URL`.
LITELLM_PUBLIC_URL=http://host.docker.internal:8200

# ═══════════════════════════════════════════════════════════════════════════
# LocalAI - Local LLM Hosting
# ═══════════════════════════════════════════════════════════════════════════
LOCALAI_EXT_PORT=8080
# Browser-facing LocalAI URL — derived from PAPAIA_HOST + LOCALAI_EXT_PORT by
# `papaia-ctl setup`. Consumed by ai/localai/docker-compose.yml (LOCALAI_BASE_URL).
# Override via `papaia-ctl setup --localai-host=URL`.
LOCALAI_PUBLIC_URL=http://host.docker.internal:8080

# ###########################################################################
# Application Services
# ###########################################################################

# ═══════════════════════════════════════════════════════════════════════════
# papaia-manager - Extension Management UI   (profile: manager)
# ═══════════════════════════════════════════════════════════════════════════
MANAGER_EXT_PORT=8120
# Browser-facing papaia-manager URL — derived from PAPAIA_HOST + MANAGER_EXT_PORT by
# `papaia-ctl setup`. Consumed by manager/docker-compose.yml (MANAGER_HOST).
# Override via `papaia-ctl setup --manager-host=URL`.
MANAGER_PUBLIC_URL=http://host.docker.internal:8120
# Role variables (MANAGER_ADMIN_ROLE, MANAGER_USER_ROLE) live in
# src/manager/.env — the manager container reads them via env_file:, and a
# root-level copy here would never reach it. See docs/configuration.md.

# ═══════════════════════════════════════════════════════════════════════════
# Homepage - Personal Dashboard
# ═══════════════════════════════════════════════════════════════════════════
HOMEPAGE_EXT_PORT=8300
# Browser-facing Homepage URL — derived from PAPAIA_HOST + HOMEPAGE_EXT_PORT by
# `papaia-ctl setup`. Consumed by the oauth2-proxy sidecar in
# services/homepage/docker-compose.yml (--redirect-url).
HOMEPAGE_PUBLIC_URL=http://host.docker.internal:8300

# ###########################################################################
# Infrastructure Services
# ###########################################################################

# ═══════════════════════════════════════════════════════════════════════════
# Nginx Proxy Manager - Reverse Proxy
# ═══════════════════════════════════════════════════════════════════════════
# internal_nginx  — bundled Nginx Proxy Manager (default); includes the
#                   oauth2-proxy sidecar that protects the NPM admin UI
# external_proxy  — bring your own proxy (Traefik, Caddy, load balancer, …);
#                   the nginx Compose profile is excluded entirely
# no_proxy        — no reverse proxy at all; services are reachable directly
#                   on their host ports (development / air-gapped setups)
REVERSE_PROXY_PROVIDER=internal_nginx
NPM_ADMIN_EXT_PORT=8100
# Public URL of the NPM admin interface — no trailing slash.
# Direct LAN setup: same host as PAPAIA_HOST plus the NPM admin port, e.g.
#   http://192.168.1.100:8100
# Behind a reverse proxy with its own FQDN:
#   https://proxy-admin.papaia.example.com
NPM_ADMIN_HOST=http://host.docker.internal:8100
# The bundled NPM admin credentials (NPM_ADMIN_EMAIL / NPM_ADMIN_PASSWORD) and
# the local API port binding (NPM_API_LOCAL_PORT) live in
# src/infra/nginx/.env — they are only consumed by the nginx compose module.

# ═══════════════════════════════════════════════════════════════════════════
# Keycloak - IAM
# ═══════════════════════════════════════════════════════════════════════════
KEYCLOAK_EXT_PORT=8110

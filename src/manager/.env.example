# papAIa — papaia-manager · environment variables
# by Fidonis GmbH · https://fidonis.de
# ═══════════════════════════════════════════════════════════════════════════

# OIDC client secret — synced from KC_MANAGER_CLIENT_SECRET during setup;
# do not edit manually.
MANAGER_OIDC_CLIENT_SECRET=GENERATE_MANAGER_OIDC_CLIENT_SECRET

# itsdangerous session signing key — generated by papaia-ctl setup.
# Generate manually with: python3 -c "import secrets; print(secrets.token_hex(32))"
MANAGER_SESSION_SECRET=GENERATE_MANAGER_SESSION_SECRET

# Keycloak realm role granting full access (add-ons, catalogs, jobs, dashboard).
MANAGER_ADMIN_ROLE=manager-admin

# Keycloak realm role granting dashboard-only access. Admins hold it implicitly.
MANAGER_USER_ROLE=user

# Keycloak realm role that may manage the realm's users and roles (the Users and Roles pages).
# The manager calls Keycloak's Admin API with the signed-in user's own token, so this
# role must carry Keycloak's user and role administration rights: papaia-admin does, through
# the realm template and the role sync (docs/adr/0006).
MANAGER_IDENTITY_ADMIN_ROLE=papaia-admin

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
